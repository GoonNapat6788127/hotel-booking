{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "description": "Public. Returns a hello message when the API is up.",
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "Hello World!"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "summary": "API root",
        "tags": [
          "health"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Public. Returns 200 while the API process is running. Use it for Docker healthchecks and server monitoring.",
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "uptime": 123.4,
                    "timestamp": "2026-11-09T08:30:00.000Z"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "summary": "Health check",
        "tags": [
          "health"
        ]
      }
    },
    "/users/me": {
      "get": {
        "description": "Returns the logged-in user (no password). Cached for 30 seconds per user.",
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "id": 1,
                    "name": "John Doe",
                    "email": "john@example.com",
                    "role": "USER",
                    "createdAt": "2026-11-01T10:00:00.000Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "404": {
            "description": "User not found"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "View my profile",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "description": "Change name and/or password of the logged-in user.",
        "operationId": "UsersController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Profile updated successfully",
                    "data": {
                      "id": 1,
                      "name": "John Doe",
                      "email": "john@example.com",
                      "role": "USER",
                      "createdAt": "2026-11-01T10:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - invalid data"
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Update my profile",
        "tags": [
          "users"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "description": "Public. Creates a USER account (send role ADMIN to create an admin). The password is hashed and never returned.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "User registered successfully",
                    "user": {
                      "id": 1,
                      "email": "john@example.com",
                      "name": "John Doe",
                      "role": "USER"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - invalid or incomplete data"
          },
          "409": {
            "description": "Conflict - email already registered"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "summary": "Register a new account",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Public. Returns a JWT. Click Authorize in Swagger UI and paste the access_token.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - invalid or incomplete data"
          },
          "401": {
            "description": "Unauthorized - invalid credentials"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "summary": "Log in",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Revokes the current token so it cannot be used again.",
