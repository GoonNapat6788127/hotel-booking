  "info": {
    "title": "Hotel Booking API",
    "description": "REST API for searching rooms, managing bookings and administering hotel data.\n\nHow to authorize: call POST /auth/login, copy the access_token, click Authorize and paste it.\n\nRate limiting:\n- 100 requests per minute per client.\n- Exceeding the limit returns 429 Too Many Requests.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "users",
      "description": ""
    },
    {
      "name": "rooms",
      "description": ""
    },
    {
      "name": "bookings",
      "description": ""
    },
    {
      "name": "notifications",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Use: Authorization: Bearer <access_token>",
        "in": "header"
      }
    },
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Smith",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "example": "NewPassword123",
            "minLength": 8,
            "maxLength": 72
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "john@example.com",
            "maxLength": 191
          },
          "password": {
            "type": "string",
            "example": "MyPassword123",
            "minLength": 8,
            "maxLength": 72,
            "description": "Stored as a bcrypt hash, never returned"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "default": "USER",
            "example": "USER"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "example": "MyPassword123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "number",
            "example": 1
          },
          "checkIn": {
            "format": "date-time",
            "type": "string",
            "example": "2026-12-01T14:00:00Z",
            "description": "ISO 8601 date/time"
          },
          "checkOut": {
            "format": "date-time",
            "type": "string",
            "example": "2026-12-03T12:00:00Z",
            "description": "ISO 8601 date/time"
          }
        },
        "required": [
          "roomId",
          "checkIn",
          "checkOut"
        ]
      },
      "UpdateBookingStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "CANCELLED",
              "PAID"
            ],
            "example": "APPROVED"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}