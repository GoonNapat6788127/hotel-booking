    "/bookings": {
      "post": {
        "description": "Logged-in user. Status starts as PENDING and a BOOKING_CREATED notification is recorded. checkIn must be before checkOut and the room must be free for the dates.",
        "operationId": "BookingsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Booking created successfully",
                    "data": {
                      "id": 12,
                      "userId": 1,
                      "roomId": 1,
                      "status": "PENDING",
                      "checkIn": "2026-12-01T14:00:00.000Z",
                      "checkOut": "2026-12-03T12:00:00.000Z",
                      "createdAt": "2026-11-09T08:30:00.000Z",
                      "room": {
                        "id": 1,
                        "name": "Deluxe Sea View",
                        "capacity": 2,
                        "pricePerNight": "2500",
                        "imageUrl": null,
                        "isActive": true,
                        "createdAt": "2026-11-01T10:00:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - invalid dates or data"
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "404": {
            "description": "Room not found or not active"
          },
          "409": {
            "description": "Conflict - room is already booked for the selected dates"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a booking",
        "tags": [
          "bookings"
        ]
      },
      "get": {
        "description": "Admin only. Optional filter by status. Includes the user and room of each booking.",
        "operationId": "BookingsController_findAll",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
