          "200": {
            "description": "Logged out successfully",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Logged out successfully"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Log out",
        "tags": [
          "auth"
        ]
      }
    },
    "/rooms": {
      "get": {
        "description": "Admin sees all rooms, regular users see only active rooms.",
        "operationId": "RoomsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of rooms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "example": {
                      "id": 1,
                      "name": "Deluxe Sea View",
                      "capacity": 2,
                      "pricePerNight": "2500",
                      "imageUrl": "/uploads/rooms/3f2b8c1e.jpg",
                      "isActive": true,
                      "createdAt": "2026-11-01T10:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List rooms",
        "tags": [
          "rooms"
        ]
      },
      "post": {
        "description": "Send as multipart/form-data. The image file is optional.",
        "operationId": "RoomsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "capacity",
                  "pricePerNight"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Deluxe Sea View"
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "example": 2
                  },
                  "pricePerNight": {
                    "type": "number",
                    "example": 2500
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "http://localhost:3000/uploads/rooms/room1.jpg",
                    "description": "Optional image URL (ignored if a file is uploaded)"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional room image (JPG, PNG or WEBP, max 10 MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Room created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Room created successfully",
                    "data": {
                      "id": 1,
                      "name": "Deluxe Sea View",
                      "capacity": 2,
                      "pricePerNight": "2500",
                      "imageUrl": "/uploads/rooms/3f2b8c1e.jpg",
                      "isActive": true,
                      "createdAt": "2026-11-01T10:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - invalid or incomplete data"
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "403": {
            "description": "Forbidden - Admin only"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a room (Admin)",
        "tags": [
          "rooms"
        ]
      }
    },
    "/rooms/search": {
      "get": {
        "description": "Only active rooms that are free for the date range are returned (checkIn and checkOut must be sent together). Cheapest first.",
        "operationId": "RoomsController_search",
        "parameters": [
          {
            "name": "checkIn",
            "required": false,
            "in": "query",
            "description": "ISO 8601. Must be sent together with checkOut",
            "schema": {
              "format": "date-time",
              "example": "2026-12-01T14:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "checkOut",
            "required": false,
            "in": "query",
            "description": "ISO 8601. Must be after checkIn",
            "schema": {
              "format": "date-time",
              "example": "2026-12-03T12:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "capacity",
            "required": false,
            "in": "query",
            "description": "Minimum number of guests",
            "schema": {
              "minimum": 1,
              "example": 2,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "description": "Maximum price per night",
            "schema": {
              "minimum": 0,
              "example": 3000,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching rooms",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Rooms retrieved successfully",
                    "count": 1,
                    "data": [
                      {
                        "id": 1,
                        "name": "Deluxe Sea View",
                        "capacity": 2,
                        "pricePerNight": "2500",
                        "imageUrl": "/uploads/rooms/3f2b8c1e.jpg",
                        "isActive": true,
                        "createdAt": "2026-11-01T10:00:00.000Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - invalid query (e.g. only one date, or checkIn not before checkOut)"
          },
          "401": {
            "description": "Unauthorized - missing, invalid or revoked token"
          },
          "429": {
            "description": "Too Many Requests"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Search available rooms",
        "tags": [
          "rooms"
        ]
      }
    },
