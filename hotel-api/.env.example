# ---- App ----
PORT="3000"
NODE_ENV="production"

# ---- Database (used by docker compose for the MySQL container) ----
MYSQL_ROOT_PASSWORD="change-me-root-password"
MYSQL_DATABASE="hotel_booking"

# Inside Docker the host is "db" (the service name), NOT localhost.
# The password here must match MYSQL_ROOT_PASSWORD.
DATABASE_URL="mysql://root:change-me-root-password@db:3306/hotel_booking"

# ---- Seeded admin account ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30m"
BCRYPT_ROUNDS="12"